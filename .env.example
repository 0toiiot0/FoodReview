# Google Cloud Console(https://console.cloud.google.com)에서 Places API (New)를 활성화하고
# 발급받은 API 키를 아래에 입력한 뒤, 이 파일을 .env.local로 복사하세요 (vercel dev용, gitignore됨).
# 배포 환경(Vercel)에서는 프로젝트 대시보드의 Environment Variables에 동일한 이름으로 등록해야 합니다.
# 이 키는 api/reviews.js(서버리스 함수) 안에서만 사용되며 브라우저로 전달되지 않습니다.
GOOGLE_PLACES_API_KEY=

# Google AI Studio(https://aistudio.google.com)에서 Gemini API 키를 발급받아 아래에 입력한 뒤,
# 이 파일을 .env.local로 복사하세요 (vercel dev용, gitignore됨).
# 배포 환경(Vercel)에서는 프로젝트 대시보드의 Environment Variables에 동일한 이름으로 등록해야 합니다.
# 이 키는 api/analyze.js(서버리스 함수) 안에서만 사용되며 브라우저로 전달되지 않습니다.
GEMINI_API_KEY=

# Supabase 프로젝트 설정(Project Settings → API)에서 확인할 수 있는 값입니다.
# publishable(anon) key는 브라우저에 노출되어도 안전하도록 설계된 키라서
# (위 두 키와 달리) config.js를 통해 그대로 클라이언트에 전달됩니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
